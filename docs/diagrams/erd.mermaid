%% multiagent-sns — 데이터 모델 ERD (코드 기준 · main bfdf3d5 · 2026-08-27 동기화)
%% 출처는 기획서가 아니라 실제 마이그레이션이다:
%%   001_initial.sql          — 14 테이블 (+ 러너가 만드는 schema_version)
%%   002_publish_mode_triad   — channel.mode에 manual 추가 · publication.mode 스냅샷 · 수동등록 멱등 인덱스
%%   003_channel_profile      — channel_profile (온보딩 인터뷰 산출, append-only)
%%   004_chat_conversation    — chat_conversation · chat_message (키워드 챗봇, append-only)
%% 표기: mermaid 타입은 공백/괄호를 못 써서 double_precision = SQL double precision,
%%       numeric = SQL numeric(10,4)로 적었다.
%% **M6에서 학습 6표의 쓰기 경로가 열렸다.** 001에 스키마만 있고 INSERT가 0건이던
%% topic_stats · metric_observation · metric_value · reward · playbook · analysis_note는
%% 이제 sns.learning.stores.PgMetricStore가 쓴다. 각 표에 **누가 쓰는지**를 적어 둔다.
%% 남은 빈 칸은 둘뿐이다: cycle.decision(밴딧 미구현) · run_event.cost_usd(비용 원장 미기입).
erDiagram
    channel ||--o{ channel_profile : "프로필 revision (최신 1건 = 현재)"
    channel ||--o{ publication : "발행"
    channel ||--o{ chat_conversation : "대화 귀속 (채널 없이도 1급 — NULL 허용)"
    chat_conversation ||--o{ chat_message : "메시지 append-only"
    cycle ||--o{ content_item : "사이클 산출"
    cycle ||--o{ run_event : "실행 이벤트 append-only"
    cycle ||--o{ analysis_note : "분석글 (cycle_id NULL 허용)"
    topic ||--o{ content_item : "주제"
    topic ||--o{ topic_stats : "성과 집계"
    content_item ||--o{ media_asset : "렌더 산출"
    content_item ||--o{ publication : "게시"
    publication ||--o| publish_attempt : "1-1 UNIQUE 멱등 시도"
    publication ||--o{ metric_observation : "관측 창"
    metric_observation ||--o{ metric_value : "지표값"
    publication ||--o| reward : "보상"

    channel {
        uuid id PK
        text platform "CHECK instagram|youtube"
        text handle "UNIQUE platform+handle"
        text status "CHECK active|paused|revoked"
        text mode "002 CHECK auto|hybrid|manual|off — 실험 변수 FR-E1"
        bytea token_encrypted "앱레벨 Fernet 암호화 NFR-7"
        integer token_key_version "키 회전 대비"
        timestamptz created_at
    }
    channel_profile {
        uuid id PK
        uuid channel_id FK
        jsonb profile "003 — 인터뷰 산출 전체. 구조 정본 = sns.onboarding.profile"
        timestamptz created_at "개정=UPDATE 아닌 새 행. INDEX channel_id+created_at DESC"
    }
    chat_conversation {
        uuid id PK "004 — 쓰기: sns.chat.store.PgChatStore (web.chat :8003)"
        uuid channel_id FK "NULL 허용 — 채널 없이 키워드만 탐색하는 사용도 1급"
        text title "첫 사용자 발화에서 파생. 목록 화면용이라 없어도 동작한다"
        timestamptz created_at "INDEX created_at DESC (최근 대화부터)"
    }
    chat_message {
        uuid id PK "004 — append-only. UPDATE·DELETE 대상이 아니다"
        uuid conversation_id FK "ON DELETE CASCADE. INDEX conversation_id+created_at"
        text role "CHECK user|assistant|ranking|system — ranking은 LLM이 쓴 글이 아니다"
        text body "사람이 읽는 본문. role=ranking이면 비어 있을 수 있다(표는 payload가 정본)"
        jsonb payload "role=ranking: ranking_to_dict 산출 그대로 — rank_std=null을 0으로 바꾸지 않는다"
        timestamptz created_at
    }
    cycle {
        uuid id PK
        text goal_ref "goal 프리셋 키 — sns.goals 4종"
        text status "CHECK planned|running|completed|failed"
        jsonb decision "변형 선택 기록 — **여전히 미기입** (Growth 밴딧 FR-L3 미구현)"
        timestamptz started_at
        timestamptz completed_at
        timestamptz created_at
    }
    topic {
        uuid id PK
        text title "Topic 에이전트가 트렌드 근거에서 고른 제목 — 챗봇 시드면 사람이 확정한 제목"
        text summary
        text source "근거 소스명 — 챗봇 시드는 chat_seed"
        text status "CHECK proposed|approved|rejected|used"
        timestamptz created_at
    }
    topic_stats {
        uuid id PK "쓰기: MetricStore.save_reward가 **같은 트랜잭션에서 차분만** 더한다"
        uuid topic_id FK
        text format "CHECK feed_image|reels|shorts"
        text platform "CHECK instagram|youtube"
        integer trials "호출부가 따로 더하면 2로 부푼다 — 그래서 저장소가 계산한다"
        double_precision reward_sum "reward NULL은 합에 들어가지 않는다"
        timestamptz updated_at "UNIQUE topic+format+platform"
    }
    content_item {
        uuid id PK
        uuid cycle_id FK
        uuid topic_id FK
        text format "CHECK feed_image|reels|shorts — 사람은 card/video를 고르고 플랫폼이 가른다"
        text status "CHECK draft|needs_review|approved|rejected — auto=approved, hybrid=needs_review"
        text hook_pattern "CHECK bold_claim|curiosity|story|shock|question FR-G5"
        text body "LLM 착지점 1/3. 크레딧·AI 생성 표기는 **코드가** 뒤에 붙인다"
        jsonb media_spec "렌더 결정론 입력. method·style·image_ref·scene_ref가 렌더 전 못박힘"
        boolean edited_by_human "승인 화면에서 본문 수정 시 true FR-E3"
        timestamptz created_at
    }
    media_asset {
        uuid id PK
        uuid content_item_id FK
        text kind "CHECK image|video|thumbnail|audio"
        text storage_url "MediaStore seam FR-M3 — 운영 구현 없음, 스크립트의 DirMediaStore"
        text checksum "산출 바이트 sha256 = 결정론 검증"
        text quality_status "CHECK passed|failed|needs_review — 게이트 미주입 시 needs_review"
        jsonb quality_report "check_card · 영상 게이트 판정 결과"
        timestamptz created_at
    }
    publication {
        uuid id PK
        uuid content_item_id FK
        uuid channel_id FK
        text status "CHECK pending|published|failed|skipped"
        text mode "002 CHECK auto|hybrid|manual — 발행 시점 스냅샷 = 비교 단일 출처"
        text external_post_id "002 부분 UNIQUE channel_id+external_post_id. 폴러의 조회 키"
        timestamptz published_at "폴링 창의 기준 시각 — 발행 후 6·24·72h"
        timestamptz created_at "UNIQUE content_item+channel"
    }
    publish_attempt {
        uuid id PK
        uuid publication_id FK "UNIQUE — publication과 1-1"
        text state "CHECK pending|container_created|published|failed"
        text container_id "IG 2단계 컨테이너 보존 → 재시작 시 재사용"
        text error_class "CHECK auth|quota|spam_block|transient|permanent_unknown"
        text error_raw "미분류 원문 보존 FR-P4. 미배선 플랫폼도 transient로 여기 남는다"
        timestamptz created_at
        timestamptz updated_at
    }
    metric_observation {
        uuid id PK "쓰기: learning.poller.poll_due_metrics → MetricStore.save_observation"
        uuid publication_id FK
        integer window_index "0=6h 1=24h 2=72h 3+=일1회. UNIQUE publication+window (재실행 흡수)"
        timestamptz observed_at "유예를 넘긴 창은 **적지 않는다** — 없는 관측을 만들지 않는다"
    }
    metric_value {
        uuid id PK "쓰기: save_observation이 관측과 한 트랜잭션에서"
        uuid observation_id FK
        text metric_key "표준 키 — docs/plan/11-데이터모델.md 4절"
        double_precision value "결측이면 NULL — 0으로 채우지 않음 NFR-3"
        boolean missing "CHECK missing XOR value. UNIQUE observation+metric_key"
    }
    reward {
        uuid id PK "쓰기: learning.reward.run_reward_batch (대표 창 72h가 찍힌 건만)"
        uuid publication_id FK "UNIQUE — publication과 1-0..1"
        double_precision reward_value "NULL = 표본 부족, 학습 제외 FR-L2 (0.0과 다른 사실)"
        text formula_version "v0-unweighted+goal — 버전이 바뀌면 배치가 전건 재계산한다"
        timestamptz computed_at
    }
    playbook {
        uuid id PK "쓰기: learning.report — **검증 통과 후에만** 흘려보낸다(_DeferredPlaybook)"
        text scope "CHECK global|platform|format|topic"
        text scope_ref
        integer version "UNIQUE scope+scope_ref+version"
        text guidance "LLM 착지점 2/3 — 다음 사이클 Content 에이전트가 읽는다"
        timestamptz created_at
    }
    analysis_note {
        uuid id PK "쓰기: learning.report.write_analysis_note"
        uuid cycle_id FK "NULL 허용"
        text body "LLM 착지점 3/3 — 수치 재계산 금지, validator 통과분만"
        boolean insufficient_evidence "코드가 결정 (LLM 아님)"
        timestamptz created_at
    }
    run_event {
        uuid id PK
        uuid cycle_id FK "NULL 허용 — 학습 배치는 사이클 밖이라 NULL이다"
        text kind "CHECK cycle_started|cycle_completed|agent_called|tool_called|publish_attempted|metric_polled|error|cost|notice"
        jsonb payload "manual 배정·관문 차단·발행 시도·알림·폴링·reward 배치·챗봇 시드가 전부 여기"
        numeric cost_usd "numeric(10,4) FR-P6 비용 원장 — **여전히 미기입**"
        timestamptz created_at "append-only (코드 규율)"
    }
