%% multiagent-sns — 시스템 아키텍처 (v2 · 2026-08-11 개정 기획서 기준)
%% 계정 4개(auto vs hybrid) 실험 · 무료 트렌드 소스 · 알고리즘 신호 최적화 · Discord 알림 반영
flowchart TB
    subgraph SCHED["스케줄 실행 — 1주차 확정: 상주 러너(무료 VM) or GitHub Actions cron"]
        CRON["슬롯 스케줄러<br/>(발행 사이클 트리거 · 계정 4개 × 일 1건)"]
    end

    subgraph TREND["무료 트렌드 소스 (FR-G4)"]
        SRC["Google Trends RSS · 네이버 검색/데이터랩<br/>YouTube 인기영상 · GitHub 트렌딩/GeekNews"]
    end

    subgraph CORE["에이전트 코어 — deepagents Orchestrator"]
        ORCH["Orchestrator<br/>(사이클 계획/위임 · run_event 기록)"]
        A_TOPIC["Topic Agent<br/>(research_trends 툴 + topic_stats + playbook)"]
        A_CONTENT["Content Agent<br/>(훅 분리 생성 · hook_pattern 5종 기록)"]
        A_MEDIA["Media Agent<br/>(카드/영상 결정론 렌더)"]
        A_PUB["Publisher Agent<br/>(채널별 발행 어댑터 · 멱등)"]
        A_ANALYST["Analyst Agent<br/>(6·24·72h 폴링 → reward → 분석글)"]
        A_GROWTH["Growth Agent<br/>(균등 탐색+플레이북 · 밴딧은 표본 50건 후)"]
        ORCH --> A_TOPIC --> A_CONTENT --> A_MEDIA --> A_PUB
        A_PUB --> A_ANALYST --> A_GROWTH --> ORCH
    end

    subgraph LLM["판단 계층 — 저비용 혼합 (FR-C3)"]
        CLAUDE["Claude claude-sonnet-5<br/>(주제 선정·대본·분석글)"]
        GEMINI["Gemini Flash free tier<br/>(트렌드 요약·자막 분절·해시태그)"]
    end

    subgraph RENDER["미디어 렌더 (결정론 · FR-M)"]
        IMG["Pillow 카드 렌더러"]
        VID["영상 합성 — Phase 0 스파이크 확정<br/>(ffmpeg+ASS vs Remotion)"]
        TTS["TTS: Google Cloud Chirp 3 HD 권장<br/>(단어별 타임스탬프 → 자막 싱크)"]
        QG["품질 게이트 (FR-Q + FR-A2)<br/>규격·안전영역 900×1400·구조 유사도"]
        IMG --> QG
        VID --> QG
        TTS --> VID
    end

    subgraph PUBAPI["발행 어댑터 — 공식 API만 (FR-P)"]
        IGAPI["Instagram Graph API<br/>IG-auto · IG-hybrid 2계정<br/>(피드 이미지 · 릴스)"]
        YTAPI["YouTube Data API v3<br/>YT-auto · YT-hybrid 2계정<br/>(쇼츠)"]
    end

    subgraph DATA["PostgreSQL (단일 DB)"]
        DB[("channel(mode)·cycle·topic·topic_stats<br/>content_item(hook_pattern·edited_by_human)<br/>media_asset·publication·publish_attempt<br/>metric_*·reward·playbook·analysis_note·run_event")]
    end

    subgraph WEB["웹 (FastAPI + 경량 프론트)"]
        UI_IN["인사이트 탭 [필수 FR-W3]<br/>추이·기울기 · auto vs hybrid 비교<br/>신호 스코어보드 · 분석글"]
        UI_HY["hybrid 승인 화면 [필수 FR-E1/Q3]<br/>주제 선택 → 초안 수정 → 승인"]
        UI_OPT["온보딩·설정 (선택 FR-W1/W2)"]
    end

    DISCORD["Discord 웹훅 [필수 FR-W4]<br/>발행 성공/실패 + 오류 분류<br/>+ LLM 원인 분석 1줄"]

    CRON --> ORCH
    A_TOPIC -.조회.-> TREND
    CORE -.판단 호출.-> LLM
    A_MEDIA --> RENDER
    QG -->|passed만| A_PUB
    A_PUB --> PUBAPI
    PUBAPI -.지표 폴링.-> A_ANALYST
    A_ANALYST -.신호 스코어보드·조기판정<br/>FR-A1·A3.-> DB
    CORE <--> DB
    RENDER --> DB
    UI_HY -->|승인/수정| DB
    UI_IN <--> DB
    UI_OPT <--> DB
    A_PUB -.성공/실패.-> DISCORD
    ORCH -.사이클 오류.-> DISCORD
