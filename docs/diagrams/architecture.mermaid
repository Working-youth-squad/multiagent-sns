%% multiagent-sns — 시스템 아키텍처 (코드 기준 · main b020a84 · 2026-08-27 동기화)
%% 기획서(v2 2026-08-11)의 예정도가 아니라 레포에 **실재하는 모듈**을 그린다.
%% 점선 테두리 = 아직 코드가 없는 계획 항목. 실선 = 구현·테스트됨.
%% 척추는 셋: ① run_cycle(기획→제작→pending) ② run_pending_publications(발행 종결)
%% ③ 학습 배치(폴링 → reward → 분석글) — 전부 사람이 부르는 배치다.
%% 둘을 잇는 상시 스케줄러가 없어서 사람이 scripts/를 순서대로 부른다.
flowchart TB
    subgraph ENTRY["실행 진입점 — scripts/"]
        direction LR
        S_CYCLE["e2e_cycle.py<br/>run_profile_cycle.py"]
        S_WEB["run_approve_web.py :8001<br/>run_onboarding_web.py :8002<br/>run_chat_web.py :8003"]
        S_MAN["manual_register.py<br/>manual_notify_assignments.py"]
        S_AN["e2e_analyst.py<br/>e2e_youtube_pipeline.py"]
        S_MET["run_metrics_poll.py — 창 6·24·72h<br/>run_reward_batch.py<br/>run_analysis_note.py"]
        S_KW["rank_keywords.py<br/>질의어 → 키워드 랭킹 (무인증)"]
        SCHED["슬롯 스케줄러 · 발행 러너 상시 구동<br/>미구현"]
    end

    subgraph PIPE["① sns.runner.cycle.run_cycle — 결정론 코드 오케스트레이션 (에이전트 아님)"]
        direction TB
        A_TOPIC["Topic 에이전트 deepagents<br/>근거 밖 제목 거부 · 카테고리 5종 · 최근 14일 주제 제외"]
        A_CONTENT["Content 에이전트 deepagents<br/>body + media_spec + hook_pattern 5종"]
        G_TEXT["관문 (렌더 전) — LLM 0<br/>quality.safety 금지소재 + quality.signature 유사도 0.8"]
        R_RES["render.images.resolve<br/>image_query → image_ref 못박기 · 실패는 그라데이션 폴백"]
        R_MEDIA["render_media 계약 구현<br/>card: Pillow PNG · video: 3단 ffmpeg + classic + TTS"]
        G_MEDIA["품질 게이트<br/>quality.gate.check_card · render.video.quality · render.images.gate"]
        STORE["CycleStore<br/>content_item · media_asset · publication(pending, mode) · run_event"]
        A_TOPIC --> A_CONTENT --> G_TEXT
        G_TEXT -->|"통과분만 렌더"| R_RES --> R_MEDIA --> G_MEDIA --> STORE
        G_TEXT -.차단 = 렌더 안 함.-> STORE
    end

    subgraph SIDE["에이전트가 읽는 바깥"]
        direction TB
        TREND["research.trends — 고정 피드 갈래<br/>ResearchTrendsService(default_service 배선)<br/>무인증 4: google_trends·github_trending·hacker_news·lobsters<br/>키 필요 4: naver_search·naver_datalab·youtube_popular·llm_grounding<br/>소스별 10s 타임아웃 · 실패는 그 소스만 ok=false"]
        STATS["read_stats = MetricStore.read_topic_stats<br/>운영 구현 있음 (표본은 아직 0건)"]
        MODELS["agents.models — BaseChatModel 주입 seam<br/>실물 = Gemini (GEMINI_API_KEY · GEMINI_MODEL)"]
        CONTRACT["동결 계약 6종 sns.tools.contracts<br/>ResearchTrends·RenderMedia·Publish<br/>PollMetrics·ReadStats·WritePlaybook<br/>가짜 = sns.tools.fakes"]
    end

    subgraph KEYWORD["research.keywords — 질의어 갈래 (챗봇 경로 · 사이클 미배선)"]
        direction TB
        KW_SRC["자동완성 3소스 — 전부 무인증<br/>naver_autocomplete · google_suggest · youtube_suggest<br/>고정 피드와 달리 질의어를 받는다"]
        KW_RANK["research.ranking — 순수 계산<br/>백분위 등수(등수 ÷ 길이+1) · 결측은 분산에서 제외<br/>rank_std=None은 0.0이 아니다 (관측 1건 = 잴 수 없음)"]
        KW_API["rank_keywords(query) — 유일한 진입점<br/>토글 5종 · ranking_to_dict = 프로세스 경계 JSON"]
        KW_SRC --> KW_RANK --> KW_API
    end

    DB[("PostgreSQL — 마이그 001·002·003·004<br/>channel·channel_profile·cycle·topic·content_item<br/>media_asset·publication·publish_attempt·run_event<br/>chat_conversation·chat_message<br/>topic_stats·metric_*·reward·playbook·analysis_note ← learning.stores.MetricStore")]

    subgraph PUBRUN["② sns.publish.runner.run_pending_publications — 기계 발행은 auto·hybrid만"]
        direction TB
        P_RUN["게이트 배선<br/>quality_status=passed + hybrid는 content_item=approved까지"]
        P_SM["publish.state_machine.run_publish<br/>멱등(key=publication_id) · IG container_id 보존"]
        P_RUN --> P_SM
    end

    subgraph ADAPT["채널 어댑터 — 공식 API"]
        direction LR
        IG_PUB["instagram.publisher<br/>Graph 2단계 · 실계정 검증 전"]
        YT_PUB["youtube.publisher<br/>resumable · 1회 1600 units"]
        FAKEP["사이클 스크립트는 FakePublish 배선<br/>원장 종결까지만 확인"]
    end

    subgraph HUMAN["사람이 끼는 자리"]
        direction TB
        W_ON["web.onboarding — 인터뷰 5단계 + 컨셉 확정<br/>onboarding: profile·recommend·character·store"]
        W_AP["web.approve — hybrid 승인/반려<br/>승인 = content_item approved + media_asset passed"]
        P_MAN["publish.manual — 수동 발행 후 external_post_id 등록<br/>manual 채널에만 · 재등록 멱등"]
        W_IN["인사이트 탭 FR-W3 — auto/hybrid/manual 비교 화면<br/>미구현"]
    end

    subgraph OBS["관측·학습·알림"]
        direction TB
        YT_MET["youtube.metrics — Analytics v2<br/>결측=missing · 오류는 raise"]
        IG_MET["instagram.metrics — Graph Insights<br/>결측=missing · 오류는 raise"]
        A_AN["Analyst 에이전트 + signals.scoreboard<br/>수치는 코드가 계산 · 계정 자체 중앙값 대비"]
        VAL["learning.validator<br/>insufficient_evidence는 코드가 결정"]
        POLL["learning.poller + schedule<br/>기한 된 창만 · 늦은 창은 안 찍는다 · 실패는 그 건만"]
        STORED["learning.observations.StoredMetrics<br/>분석은 저장된 관측을 읽는다 (API 재호출 0)"]
        LEARN["learning.reward v0-unweighted → reward · topic_stats 차분<br/>learning.report → playbook · analysis_note<br/>계수 사전등록 전 · 실 관측 0건"]
        BANDIT["Growth 밴딧 FR-L3<br/>미구현 — 발행 50건 축적 후"]
        NOTIFY["notify.dispatch → cause(LLM 1줄) → Discord<br/>적재 먼저 · 어떤 실패도 호출자로 전파 안 함"]
        YT_MET --> POLL
        IG_MET --> POLL
        POLL --> STORED --> A_AN
        STORED --> LEARN
        A_AN --> VAL --> LEARN
        LEARN -.표본 50건.-> BANDIT
    end

    S_CYCLE --> PIPE
    S_WEB --> HUMAN
    S_MAN --> P_MAN
    S_MAN --> NOTIFY
    S_AN --> OBS
    S_MET --> OBS
    SCHED -.구동 예정.-> PUBRUN

    A_TOPIC -->|"research_trends"| TREND
    S_KW --> KW_API
    KEYWORD -.오케스트레이션 재사용<br/>동시 실행·타임아웃·실패 격리.-> TREND
    KW_API -.DB 저장 없음 · 사이클 주제 선정과 미연결.-> DB
    A_TOPIC -->|"read_stats"| STATS
    PIPE -.모델 주입.-> MODELS
    PIPE -.계약 위에서만.-> CONTRACT

    STORE --> DB
    DB --> P_RUN
    P_SM --> IG_PUB
    P_SM --> YT_PUB
    P_SM --> FAKEP
    P_SM -.실패 분류.-> NOTIFY
    PIPE -.사이클 오류 · manual 배정.-> NOTIFY
    NOTIFY --> DB

    W_ON -->|"channel_profile 새 revision"| DB
    DB -.최신 프로필 주입.-> PIPE
    W_AP -->|"발행 게이트 반전"| DB
    P_MAN --> DB
    YT_PUB -.발행 후 지표.-> YT_MET
    LEARN -->|"playbook 지침"| PIPE
    LEARN --> DB
    POLL --> DB
    W_IN -.계획.-> DB

    classDef planned stroke-dasharray: 6 4,stroke-width:1px,color:#888
    class SCHED,BANDIT,W_IN planned
