# 로컬 개발용 환경변수 템플릿.
#
#   cp .env.example .env      # (PowerShell) Copy-Item .env.example .env
#
# .env 는 gitignore 대상 — 실제 값은 절대 커밋되지 않는다.
# 운영(Docker/GitHub Actions)에서는 .env 대신 플랫폼 시크릿을 주입한다.
#
# 파일 형태의 크레덴셜(OAuth client_secret.json, token.json)은 여기가 아니라
# 리포 루트의 .secrets/ 에 둔다 (역시 gitignore 대상).
#   .secrets/client_secret.json  — GCP 콘솔 > OAuth 데스크톱 앱 클라이언트
#   .secrets/token.json          — 첫 브라우저 동의 후 자동 생성

# ── 필수 ────────────────────────────────────────────────────────────
# PostgreSQL DSN. docker compose up -d postgres 기준 기본값.
DATABASE_URL=postgresql://sns:sns@localhost:5432/sns

# 채널 토큰 앱레벨 암호화 키 (NFR-7). Fernet base64 32바이트.
# 생성: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 무효/부재 시 Config.from_env()가 기동을 막는다.
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_VERSION=1

# ── 에이전트 · 렌더 ──────────────────────────────────────────────────
# Gemini API 키 — C2 에이전트(Topic/Content/Analyst)와 C1 LLM 그라운딩 소스가 공용.
# 무료 티어: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# ── 에이전트 텍스트 모델 ────────────────────────────────────────────
# 주제·대본 생성 모델. **무료 티어 쿼터는 모델별로 따로**라(하루 20건), 하나가 소진되면
# 다른 모델로 바꿔 그날 작업을 이어갈 수 있다.
#   gemini-3.5-flash        (기본)
#   gemini-3.5-flash-lite   (별도 쿼터 — flash가 429일 때)
# 비워두면 기본값을 쓴다. gemini-2.5 계열은 은퇴해서 404다.
GEMINI_MODEL=


# C4 영상 TTS (Google Cloud Text-to-Speech 제한 API 키). 영상 렌더에만 필요.
GOOGLE_TTS_API_KEY=
# 쇼츠 컷 배경용 스톡 사진 — https://www.pexels.com/api/ 에서 무료 발급(즉시, 결제 없음).
# 없으면 사진 없이 그라데이션으로 렌더된다(영상은 나온다).
PEXELS_API_KEY=

# 생성 이미지 모델 — 항상 'provider:model' 형식. 기본 배선에서 빠져 있어(유료) 화풍 확인은
# scripts/preview_generated_image.py 로 한다. 모델 비교는 -m 을 여러 번 주면 된다.
#   google:gemini-3.1-flash-lite-image  (기본, 가장 쌈)
#   google:gemini-3-pro-image | google:nano-banana-pro-preview
#   openai:gpt-image-1 | openai:gpt-image-1-mini | openai:dall-e-3
# Google 이미지 모델은 **무료 티어 할당량이 0**이라 결제를 켠 프로젝트에서만 동작한다.
IMAGE_GEN_MODEL=google:gemini-3.1-flash-lite-image

# openai: 모델을 쓸 때만 필요. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── 트렌드 소스 (선택) ───────────────────────────────────────────────
# 없으면 그 소스만 미등록되어 조용히 건너뛴다(ok=False 격리). 무인증 소스
# (google_trends·github_trending)는 키 없이 항상 동작한다.

# 네이버 검색 + 데이터랩 2종 공용. https://developers.naver.com/apps
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# YouTube Data API v3 인기 영상. GCP 콘솔에서 API 활성화 후 키 발급.
YOUTUBE_API_KEY=

# ── 알림 ────────────────────────────────────────────────────────────
# C6 Discord 웹훅. 채널 설정 > 연동 > 웹훅 > URL 복사. 없으면 DB 적재만 하고 전송은 생략.
DISCORD_WEBHOOK_URL=

# ── 선택 ────────────────────────────────────────────────────────────
# 카드 렌더 한글 폰트 TTF 경로. 미지정 시 OS별 기본 후보를 자동 탐색한다.
# CARD_FONT=C:/Windows/Fonts/malgun.ttf
